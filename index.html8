--// PANEL 4: SEMUA 190 FITUR (1..190)
do
	local p = Panels["All190"]
	for idx, item in ipairs(Registry) do
		local row = math.floor((idx - 1) / 2)
		local col = (idx - 1) % 2
		MakeAction(p, 4 + col * 286, 4 + row * 32, 282, 28, string.format("#%d %s", item.id, item.name), item.run)
	end
end

