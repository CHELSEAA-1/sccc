-- 101..145: Server, Character, Camera & Utility Packs
Reg("Rejoin Server", "Server", "Masuk ulang ke server saat ini", function() TeleportService:TeleportToPlaceInstance(game.PlaceId, game.JobId, LocalPlayer) end)
Reg("Server Hop", "Server", "Pindah ke server publik lain", function()
	pcall(function()
		local raw = game:HttpGet("https://games.roblox.com/v1/games/" .. game.PlaceId .. "/servers/Public?sortOrder=Asc&limit=100")
		local data = HttpService:JSONDecode(raw)
		if data and data.data then
			for _, s in ipairs(data.data) do
				if s.id ~= game.JobId and s.playing < s.maxPlayers then
					TeleportService:TeleportToPlaceInstance(game.PlaceId, s.id, LocalPlayer)
					break
				end
			end
		end
	end)
end)
