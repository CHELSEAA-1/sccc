	MakeAction(p, 436, 106, 134, 28, "Stop Tween", function() Lookup["stop active tween"].run() end, Color3.fromRGB(58, 18, 28))

	MakeAction(p, 4, 140, 186, 28, "Tween Sky +600", function() Lookup["tween sky +600"].run() end)
	MakeAction(p, 194, 140, 186, 28, "Instant TP Nearest", function() Lookup["tp nearest player"].run() end)
