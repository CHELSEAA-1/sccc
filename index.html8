-- 146..190: Extended Tactical & Admin Macros
for i = 146, 190 do
	local idx = i - 145
	if idx % 5 == 1 then
		Reg("Boost Sprint #" .. idx, "Movement", "Sprint boost +45 WS", function()
			State.WalkSpeed = math.min(1000, State.WalkSpeed + 45)
			State.WalkSpeedLock = true
			local h = GetHum() if h then h.WalkSpeed = State.WalkSpeed end
		end)
	elseif idx % 5 == 2 then
		Reg("Vault Jump #" .. idx, "Movement", "Jump boost +25 JP", function()
			State.JumpPower = math.min(1000, State.JumpPower + 25)
			State.JumpPowerLock = true
			local h = GetHum() if h then h.UseJumpPower = true h.JumpPower = State.JumpPower end
		end)
	elseif idx % 5 == 3 then
		Reg("Pulse Click #" .. idx, "Auto", "Trigger tap layar cepat", function()
			local vp = Workspace.CurrentCamera and Workspace.CurrentCamera.ViewportSize or Vector2.new(500, 500)
			TapScreen(vp.X * 0.5, vp.Y * 0.5, nil)
		end)
	elseif idx % 5 == 4 then
		Reg("Ring Platform #" .. idx, "World", "Spawn platform cincin #" .. idx, function()
			SpawnPart(Vector3.new(12, 1, 12), CFrame.new((idx % 6 - 2.5) * 6, -3.5, -10), Color3.fromRGB(244, 114, 182), Enum.Material.Neon, 0.3)
		end)
	else
		Reg("Status Ping #" .. idx, "Utility", "Tampilkan info FPS & Ping", function()
			local fps = math.floor(1 / math.max(RunService.RenderStepped:Wait(), 0.001))
			local ping = 0
			pcall(function() ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue()) end)
			SetMsg(string.format("FPS: %d | Ping: %d ms | Total FX: %d", fps, ping, #Registry))
		end)
	end
end

-- Expose global helper
pcall(function()
	getgenv().ChelseaaSystem = {
		Total = #Registry,
		Run = function(q)
			local it = Lookup[string.lower(tostring(q or ""))]
			if it then it.run() end
		end,
	}
end)

